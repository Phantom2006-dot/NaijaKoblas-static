# Neon pooled URL for runtime queries. Keep this secret.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Neon direct URL for Drizzle migrations. Keep this secret.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require

# Configure both Clerk server keys together. The secret key must never be exposed to the browser.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The first authenticated Clerk user with this exact ID may bootstrap the first app administrator once.
# Set only after confirming the Clerk user ID through a trusted server-side flow.
OWNER_CLERK_USER_ID=

# Paystack secret key, test mode first. Never expose this value to the browser.
PAYSTACK_SECRET_KEY=

# Durable product image uploads use Cloudinary; configure all three values in Fly Secrets.
# Product uploads stay disabled until the complete Cloudinary credential set is present.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Exact public storefront origin (HTTPS in production), with no path/query/fragment.
# Required whenever either Clerk server key is configured; HTTP is allowed only for localhost in development.
APP_BASE_URL=

# Public Vite build-time key for the browser. Set in Vercel; it is not a secret and must match CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional public API origin for a separately hosted Express API. Leave blank when /api is
# proxied through Vercel on the same storefront origin.
VITE_API_BASE_URL=

# Manus API values below are optional platform-service credentials only. They do not provide login.
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
