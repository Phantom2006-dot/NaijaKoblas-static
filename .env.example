# Neon pooled URL for the running application. Keep this secret.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Neon direct URL for Drizzle migrations. Keep this secret.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require

# Set only after the owner has completed OAuth and the exact server-side account identity is known.
OWNER_OPEN_ID=

# Paystack secret key, test mode first. Never expose this value to the browser.
PAYSTACK_SECRET_KEY=

# Public HTTPS origin serving the storefront, e.g. https://naijakoblas.com
APP_BASE_URL=

# Optional public Vite build-time origin for a separately hosted Express API.
# Leave blank when the storefront and API share one origin. Never place secrets here.
VITE_API_BASE_URL=

# Confirm the merchant account is enabled for Nigerian cards, bank transfer and USSD in its Paystack Dashboard.
# Seller subaccounts, split amounts, commission rules and vendor-bank verification are not configured yet.

# Existing Manus OAuth configuration. These are distinct service endpoints.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
