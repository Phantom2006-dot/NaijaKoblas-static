# Neon pooled URL for the running application. Keep this secret.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Neon direct URL for Drizzle migrations. Keep this secret.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require

# Set only after the owner has completed OAuth and the server-side account identity is known.
OWNER_OPEN_ID=

# Paystack secret key. Use a test key until the backend deployment and webhook are verified.
PAYSTACK_SECRET_KEY=

# Public HTTPS origin serving the backend and storefront, e.g. https://naijakoblas.com
APP_BASE_URL=

# Existing Manus OAuth/runtime configuration (deployment-specific).
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
